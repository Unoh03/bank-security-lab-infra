    "panel-4": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "efubxj2vag7i8b"
                    },
                    "group": "grafana-athena-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "connectionArgs": {
                        "catalog": "__default",
                        "database": "__default",
                        "region": "__default",
                        "resultReuseEnabled": false,
                        "resultReuseMaxAgeInMinutes": 60
                      },
                      "format": 1,
                      "rawSQL": "WITH css_clients AS (\r\n    SELECT DISTINCT \"c-ip\" AS source_ip\r\n    FROM aws_topology_security.cloudfront_access\r\n    WHERE \"cs-uri-stem\" LIKE '/dvwa/css/%'\r\n      AND concat(date, ' ', time)\r\n          BETWEEN $__rawTimeFrom('yyyy-MM-dd HH:mm:ss')\r\n              AND $__rawTimeTo('yyyy-MM-dd HH:mm:ss')\r\n)\r\n\r\nSELECT\r\n    c.date,\r\n    c.time,\r\n    concat(\r\n    split_part(c.\"c-ip\", '.', 1), '.',\r\n    split_part(c.\"c-ip\", '.', 2), '.',\r\n    split_part(c.\"c-ip\", '.', 3), '.xxx'\r\n) AS source_ip,\r\n    c.\"cs-method\" AS method,\r\n    c.\"cs-uri-stem\" AS path,\r\n    c.\"sc-status\" AS status,\r\n    c.\"cs-protocol\" AS protocol,\r\n    c.\"time-taken\" AS time_taken\r\nFROM aws_topology_security.cloudfront_access c\r\nJOIN css_clients s\r\n    ON c.\"c-ip\" = s.source_ip\r\nWHERE concat(c.date, ' ', c.time)\r\n      BETWEEN $__rawTimeFrom('yyyy-MM-dd HH:mm:ss')\r\n          AND $__rawTimeTo('yyyy-MM-dd HH:mm:ss')\r\nORDER BY c.date ASC, c.time ASC\r\nLIMIT 200;"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "",
