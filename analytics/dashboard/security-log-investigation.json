                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "efubxj2vag7i8b"
                    },
                    "group": "grafana-athena-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "connectionArgs": {
                        "catalog": "__default",
                        "database": "__default",
                        "region": "__default",
                        "resultReuseEnabled": false,
                        "resultReuseMaxAgeInMinutes": 60
                      },
                      "format": 1,
                      "rawSQL": "SELECT\r\n    CAST(dstport AS varchar) AS destination_port,\r\n    COUNT(*) AS rejected_flows\r\nFROM aws_topology_security.vpc_reject\r\nWHERE action = 'REJECT'\r\n  AND $__unixEpochFilter(start)\r\nGROUP BY dstport\r\nORDER BY rejected_flows DESC\r\nLIMIT 10;"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
