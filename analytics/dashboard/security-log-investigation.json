                  "query": {
                    "datasource": {
                      "name": "efubxj2vag7i8b"
                    },
                    "group": "grafana-athena-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "connectionArgs": {
                        "catalog": "__default",
                        "database": "__default",
                        "region": "__default",
                        "resultReuseEnabled": false,
                        "resultReuseMaxAgeInMinutes": 60
                      },
                      "format": 1,
                      "rawSQL": "SELECT\r\n    \"cs-uri-stem\" AS path,\r\n    COUNT(*) AS requests\r\nFROM aws_topology_security.cloudfront_access\r\nWHERE \"cs-uri-stem\" IS NOT NULL\r\n  AND concat(date, ' ', time)\r\n      BETWEEN $__rawTimeFrom('yyyy-MM-dd HH:mm:ss')\r\n          AND $__rawTimeTo('yyyy-MM-dd HH:mm:ss')\r\nGROUP BY \"cs-uri-stem\"\r\nORDER BY requests DESC\r\nLIMIT 10;"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
