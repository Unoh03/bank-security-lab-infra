#!/usr/bin/env python3
"""Send only the approved Rule 100104 S3 fields to Shuffle Cloud."""

from __future__ import annotations

import hashlib
import http.client
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any
from urllib.parse import urlsplit


EXPECTED_ACCOUNT_ID = "433048100798"
EXPECTED_REGION = "ap-northeast-2"
EXPECTED_RULE_ID = "100104"
EXPECTED_RULE_LEVEL = 12
EXPECTED_EVENT_SOURCE = "s3.amazonaws.com"
EXPECTED_EVENT_NAME = "GetObject"
EXPECTED_CLOUDTRAIL_SOURCE = "cloudtrail"
EXPECTED_USER_IDENTITY_TYPE = "AssumedRole"
EXPECTED_ROLE_NAME = "aws-topology-primary-karpenter-node"
EXPECTED_BUCKET_NAME = "aws-topology-primary-bd56288914d9d31c4d07225deb"
EXPECTED_OBJECT_KEY = "validation/capital-one-demo.csv"
EXPECTED_BUCKET_ALIAS = "primary-application-data"
EXPECTED_HTTP_STATUS = "200"
ROLE_METADATA = "high_confidence_s3_access"
MAX_PRINCIPAL_ID_BYTES = 512
MAX_FULL_LOG_BYTES = 262144
ALERT_ID_PATTERN = re.compile(r"^[0-9]+\.[0-9]+$")
EVENT_ID_PATTERN = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
    re.IGNORECASE,
)
HEADER_KEY_PATTERN = re.compile(r"^[A-Za-z0-9.*+?-]{24,128}$")
WEBHOOK_ID_PATTERN = r"[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
WEBHOOK_PATH_PATTERNS = (
    re.compile(rf"^/api/v1/hooks/(?P<id>{WEBHOOK_ID_PATTERN})$"),
    re.compile(rf"^/api/v1/hooks/webhook_(?P<id>{WEBHOOK_ID_PATTERN})$"),
    re.compile(rf"^/api/v1/webhooks/webhook_(?P<id>{WEBHOOK_ID_PATTERN})$"),
)
WEBHOOK_URL_PATH = Path("/var/ossec/soc-secrets/shuffle_webhook_url")
WEBHOOK_HEADER_KEY_PATH = Path(
    "/var/ossec/soc-secrets/shuffle_webhook_header_key"
)


class ContractError(Exception):
    """An alert or runtime value violated the frozen SOC contract."""


def require_object(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ContractError(f"{label} must be an object")
    return value


def parse_utc_timestamp(value: Any, label: str) -> str:
    if not isinstance(value, str) or len(value) > 40:
        raise ContractError(f"{label} must be a bounded UTC timestamp")
    normalized = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        parsed = datetime.fromisoformat(normalized)
    except ValueError as error:
        raise ContractError(f"{label} must be ISO 8601") from error
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        raise ContractError(f"{label} must include a UTC offset")
    if parsed.utcoffset().total_seconds() != 0:
        raise ContractError(f"{label} must be UTC")
    return parsed.astimezone(timezone.utc).isoformat(timespec="milliseconds").replace(
        "+00:00", "Z"
    )


def canonical_json(value: dict[str, Any]) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


def bounded_text(value: Any, label: str, max_bytes: int) -> tuple[str, bytes]:
    if not isinstance(value, str) or not value:
        raise ContractError(f"{label} must be a non-empty string")
    try:
        encoded = value.encode("utf-8")
    except UnicodeEncodeError as error:
        raise ContractError(f"{label} is not valid UTF-8") from error
    if len(encoded) > max_bytes:
        raise ContractError(f"{label} exceeds the bounded size")
    return value, encoded


def build_sanitized_alert(alert: dict[str, Any], now: datetime | None = None) -> dict[str, Any]:
    rule = require_object(alert.get("rule"), "rule")
    data = require_object(alert.get("data"), "data")
    aws = require_object(data.get("aws"), "data.aws")
    request_parameters = require_object(
        aws.get("requestParameters"), "data.aws.requestParameters"
    )
    user_identity = require_object(
        aws.get("userIdentity"), "data.aws.userIdentity"
    )
    session_context = require_object(
        user_identity.get("sessionContext"),
        "data.aws.userIdentity.sessionContext",
    )
    session_issuer = require_object(
        session_context.get("sessionIssuer"),
        "data.aws.userIdentity.sessionContext.sessionIssuer",
    )
    additional_event_data = require_object(
        aws.get("additionalEventData"), "data.aws.additionalEventData"
    )

    if str(rule.get("id")) != EXPECTED_RULE_ID:
        raise ContractError("rule.id is not allowlisted")
    if rule.get("level") != EXPECTED_RULE_LEVEL:
        raise ContractError("rule.level is not allowlisted")
    if aws.get("source") != EXPECTED_CLOUDTRAIL_SOURCE:
        raise ContractError("data.aws.source is not cloudtrail")
    if aws.get("eventSource") != EXPECTED_EVENT_SOURCE:
        raise ContractError("aws.eventSource is not allowlisted")
    if aws.get("eventName") != EXPECTED_EVENT_NAME:
        raise ContractError("aws.eventName is not allowlisted")
    if aws.get("recipientAccountId") != EXPECTED_ACCOUNT_ID:
        raise ContractError("aws.recipientAccountId is not allowlisted")
    if aws.get("awsRegion") != EXPECTED_REGION:
        raise ContractError("aws.awsRegion is not allowlisted")
    if request_parameters.get("bucketName") != EXPECTED_BUCKET_NAME:
        raise ContractError("aws.requestParameters.bucketName is not allowlisted")
    if request_parameters.get("key") != EXPECTED_OBJECT_KEY:
        raise ContractError("aws.requestParameters.key is not allowlisted")
    if session_issuer.get("userName") != EXPECTED_ROLE_NAME:
        raise ContractError("approved principal role is not allowlisted")
    if user_identity.get("type") != EXPECTED_USER_IDENTITY_TYPE:
        raise ContractError("data.aws.userIdentity.type is not AssumedRole")
    http_status = additional_event_data.get("httpStatusCode")
    if not (
        (type(http_status) is int and http_status == 200)
        or (type(http_status) is str and http_status == EXPECTED_HTTP_STATUS)
    ):
        raise ContractError("aws.additionalEventData.httpStatusCode is not 200")
    if aws.get("errorCode") not in (None, ""):
        raise ContractError("aws.errorCode must be absent or empty")

    event_id = aws.get("eventID")
    if not isinstance(event_id, str) or not EVENT_ID_PATTERN.fullmatch(event_id):
        raise ContractError("aws.eventID is not a UUID")
    event_id = event_id.lower()
    alert_id = alert.get("id")
    if not isinstance(alert_id, str) or not ALERT_ID_PATTERN.fullmatch(alert_id):
        raise ContractError("Wazuh alert id is invalid")
    event_time = parse_utc_timestamp(aws.get("eventTime"), "aws.eventTime")
    _, full_log_bytes = bounded_text(
        alert.get("full_log"), "alert.full_log", MAX_FULL_LOG_BYTES
    )
    _, principal_id_bytes = bounded_text(
        user_identity.get("principalId"),
        "data.aws.userIdentity.principalId",
        MAX_PRINCIPAL_ID_BYTES,
    )
    raw_sha256 = hashlib.sha256(full_log_bytes).hexdigest()
    principal_session_sha256 = hashlib.sha256(principal_id_bytes).hexdigest()

    sent_at = now or datetime.now(timezone.utc)
    if sent_at.tzinfo is None or sent_at.utcoffset() is None:
        raise ContractError("sent_at source must be timezone-aware")

    sanitized: dict[str, Any] = {
        "schema_version": 2,
        "source_system": "wazuh",
        "sent_at_utc": sent_at.astimezone(timezone.utc)
        .isoformat(timespec="milliseconds")
        .replace("+00:00", "Z"),
        "account_alias": "primary-lab",
        "aws_account_id": EXPECTED_ACCOUNT_ID,
        "aws_region": EXPECTED_REGION,
        "scenario_id": "CAPITAL-ONE",
        "rule": {
            "id": EXPECTED_RULE_ID,
            "level": EXPECTED_RULE_LEVEL,
            "role": ROLE_METADATA,
        },
        "incident": {
            "cloudtrail_event_id": event_id,
            "wazuh_alert_id": alert_id,
            "event_time_utc": event_time,
            "event_source": EXPECTED_EVENT_SOURCE,
            "event_name": EXPECTED_EVENT_NAME,
            "principal_role_name": EXPECTED_ROLE_NAME,
            "principal_session_id_sha256": principal_session_sha256,
            "bucket_alias": EXPECTED_BUCKET_ALIAS,
            "object_key": EXPECTED_OBJECT_KEY,
            "result": "success",
        },
        "integrity": {
            "raw_message_sha256": raw_sha256,
        },
    }
    body_sha256 = hashlib.sha256(canonical_json(sanitized)).hexdigest()
    sanitized["integrity"]["body_sha256"] = body_sha256
    return sanitized


def validate_webhook_url(value: str) -> tuple[str, str]:
    try:
        parsed = urlsplit(value)
    except ValueError as error:
        raise ContractError("Shuffle webhook URL is invalid") from error
    host = (parsed.hostname or "").lower()
    if (
        parsed.scheme != "https"
        or parsed.username is not None
        or parsed.password is not None
        or parsed.port is not None
        or parsed.query
        or parsed.fragment
        or not (host == "shuffler.io" or host.endswith(".shuffler.io"))
    ):
        raise ContractError("Shuffle webhook URL is outside the allowlist")
    if not any(pattern.fullmatch(parsed.path) for pattern in WEBHOOK_PATH_PATTERNS):
        raise ContractError("Shuffle webhook ID is invalid")
    return host, parsed.path


def read_runtime_secret(path: Path) -> str:
    try:
        value = path.read_text(encoding="utf-8").strip()
    except OSError as error:
        raise ContractError("required Runtime Secret is unavailable") from error
    if not value:
        raise ContractError("required Runtime Secret is empty")
    return value


def send_to_shuffle(
    sanitized: dict[str, Any], webhook_url: str, header_key: str
) -> None:
    host, path = validate_webhook_url(webhook_url)
    if not HEADER_KEY_PATTERN.fullmatch(header_key):
        raise ContractError("Shuffle webhook header key is invalid")

    body = canonical_json(sanitized)
    connection = http.client.HTTPSConnection(host, timeout=10)
    try:
        connection.request(
            "POST",
            path,
            body=body,
            headers={
                "Content-Type": "application/json",
                "Content-Length": str(len(body)),
                "X-SOC-Webhook-Key": header_key,
            },
        )
        response = connection.getresponse()
        response.read(1024)
        if response.status < 200 or response.status >= 300:
            raise ContractError("Shuffle webhook returned a non-success status")
    except (OSError, http.client.HTTPException) as error:
        raise ContractError("Shuffle webhook delivery failed") from error
    finally:
        connection.close()


def main() -> int:
    if len(sys.argv) < 2:
        print("custom-shuffle-soc: missing Wazuh alert file", file=sys.stderr)
        return 2

    try:
        with open(sys.argv[1], "r", encoding="utf-8") as handle:
            alert = json.load(handle)
        if not isinstance(alert, dict):
            raise ContractError("Wazuh alert must be an object")
        sanitized = build_sanitized_alert(alert)
        webhook_url = read_runtime_secret(WEBHOOK_URL_PATH)
        header_key = read_runtime_secret(WEBHOOK_HEADER_KEY_PATH)
        send_to_shuffle(sanitized, webhook_url, header_key)
    except (OSError, json.JSONDecodeError, ContractError) as error:
        print(
            f"custom-shuffle-soc: rejected or failed ({type(error).__name__})",
            file=sys.stderr,
        )
        return 1

    print(
        "custom-shuffle-soc: sanitized Rule 100104 alert delivered",
        file=sys.stderr,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
